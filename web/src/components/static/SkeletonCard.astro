---
interface Props {
  lines?: number;
}
const { lines = 4 } = Astro.props;
---

<div class="skeleton-card card">
  {Array.from({ length: lines }).map((_, i) => (
    <div class="skeleton" style={`height: 1.2em; width: ${85 - i * 10}%; margin-bottom: 0.6rem;`} />
  ))}
</div>

<style>
  .skeleton-card {
    min-height: 120px;
  }
</style>
