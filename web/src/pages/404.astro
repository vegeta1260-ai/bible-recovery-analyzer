---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="找不到頁面（404）" description="找不到這個頁面。回到首頁或從書卷、字典、常見問題重新開始。" noindex={true}>
  <section class="notfound">
    <p class="code">404</p>
    <h1>找不到這個頁面</h1>
    <p class="msg">你要找的內容可能已移動或不存在。試試從下面重新開始：</p>
    <ul class="links">
      <li><a href={`${base}/`}>回首頁</a></li>
      <li><a href={`${base}/books`}>書卷總覽（66 卷）</a></li>
      <li><a href={`${base}/lexicon`}>原文字典</a></li>
      <li><a href={`${base}/faq`}>常見問題</a></li>
    </ul>
  </section>
</BaseLayout>
<style>
  .notfound { text-align: center; padding: 4rem 1rem; max-width: 560px; margin: 0 auto; }
  .code { font-family: var(--font-mono); font-size: 4rem; font-weight: 700; color: var(--color-primary); line-height: 1; }
  .notfound h1 { font-size: var(--font-2xl); margin: 0.5rem 0 1rem; }
  .msg { color: var(--color-text-secondary); margin-bottom: 1.5rem; }
  .links { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .links a { font-size: var(--font-lg); }
</style>
