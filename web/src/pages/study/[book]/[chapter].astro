---
// 逐章研經落地頁 /study/[book]/[chapter]
// 靜態烤入：原文逐字對照（公版，可索引）+ A 導覽地圖 + JSON-LD。
// runtime 疊上：恢復本經文（LSM 版權，由 ChapterRecovery island 填入 slot）。
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import bookMap from '../../../data/bookMap.json';
import lexiconData from '../../../data/lexicon.json';
import lastmod from '../../../data/lastmod.json';
import ChapterRecovery from '../../../components/islands/ChapterRecovery.tsx';
import ChapterReadAloud from '../../../components/islands/ChapterReadAloud.tsx';
import ChapterMusic from '../../../components/islands/ChapterMusic.tsx';
import { buildLsmChapterRef } from '../../../lib/lsmApi';

type BookEntry = { osis: string; english: string; zh: string; aliases: string[] };
// 壓縮 token 的短 key（見 scripts/compress-tokens.py / lib/analyzer.ts）
type CToken = { r: string; o: number; s: string; l: string; ac?: string; pos?: string; st?: string; ge?: string; tr?: string };

// 新約 27 卷 OSIS（與 hub 頁 / BookGrid 同一份清單）：據此判定原文語言，
// 不再從 token 的 Strong's 前綴推斷（token 缺 st 時會誤判）。
const NT_OSIS = new Set(['Matt','Mark','Luke','John','Acts','Rom','1Cor','2Cor','Gal','Eph','Phil','Col','1Thess','2Thess','1Tim','2Tim','Titus','Phlm','Heb','Jas','1Pet','2Pet','1John','2John','3John','Jude','Rev']);

// 逐章概要（~250–400 字，LLM 逐卷生成，66 卷 / 1189 章全覆蓋，用於「本章概要」）
const summaryFiles = import.meta.glob<{ default: Record<string, string> }>(
  '../../../data/chapter-summaries/*.json',
  { eager: true },
);
// 選填的本章默想/禱讀引導（逐步補齊；沒有就不顯示）
const meditationFiles = import.meta.glob<{ default: Record<string, string> }>(
  '../../../data/chapter-meditations/*.json',
  { eager: true },
);

export async function getStaticPaths() {
  const books = bookMap as BookEntry[];
  const tokensDir = path.join(process.cwd(), 'public', 'data', 'tokens');
  const paths: any[] = [];

  for (const b of books) {
    const file = path.join(tokensDir, `${b.osis}.json`);
    if (!fs.existsSync(file)) continue;
    let toks: CToken[];
    try {
      toks = JSON.parse(fs.readFileSync(file, 'utf-8')) as CToken[];
    } catch {
      continue;
    }
    // 依 verse_ref（Book.Chapter.Verse）分章、分節
    const chapters = new Map<string, Map<string, CToken[]>>();
    for (const t of toks) {
      if (!t || !t.r) continue;
      const parts = t.r.split('.');
      if (parts.length < 3) continue;
      const ch = parts[1];
      const vs = parts[2];
      if (!chapters.has(ch)) chapters.set(ch, new Map());
      const vmap = chapters.get(ch)!;
      if (!vmap.has(vs)) vmap.set(vs, []);
      vmap.get(vs)!.push(t);
    }

    const allChapters = [...chapters.keys()].map(Number).sort((a, c) => a - c);
    for (const [ch, vmap] of chapters) {
      const verses = [...vmap.entries()]
        .map(([num, vt]) => ({
          num: Number(num),
          tokens: vt.sort((a, c) => a.o - c.o),
        }))
        .sort((a, c) => a.num - c.num);

      // 恢復本有、原文古卷多無的節（如 Rom 16:25-27 頌讚）：補空原文 slot，
      // 讓 runtime 恢復本各自分行顯示（原文逐字對照區標示古卷多無）。
      const extraVerses = (
        { Rom: { 16: [25, 26, 27] } } as Record<string, Record<number, number[]>>
      )[b.osis]?.[Number(ch)] ?? [];
      for (const n of extraVerses) {
        if (!verses.some((v) => v.num === n)) verses.push({ num: n, tokens: [] as CToken[] });
      }
      if (extraVerses.length) verses.sort((a, c) => a.num - c.num);

      // A 導覽：高頻 lemma、Strong's 熱點、token 數
      const lemmaCount = new Map<string, number>();
      const strongsCount = new Map<string, number>();
      // 內容詞（名詞/動詞/形容詞）的 Strong's 統計，排除虛詞（冠詞/連詞/介系詞/代名詞/質詞/副詞），
      // 供「本章關鍵原文字」prose 顯示有主題意義的字，而非 the/and/of 之類。
      const contentStrongsCount = new Map<string, number>();
      const CONTENT_POS = new Set(['noun', 'verb', 'adjective']);
      let tokenCount = 0;
      for (const v of verses) {
        for (const t of v.tokens) {
          tokenCount++;
          if (t.l) lemmaCount.set(t.l, (lemmaCount.get(t.l) ?? 0) + 1);
          if (t.st) strongsCount.set(t.st, (strongsCount.get(t.st) ?? 0) + 1);
          if (t.st && CONTENT_POS.has(t.pos ?? '')) contentStrongsCount.set(t.st, (contentStrongsCount.get(t.st) ?? 0) + 1);
        }
      }
      const topLemmas = [...lemmaCount.entries()]
        .sort((a, c) => c[1] - a[1]).slice(0, 6)
        .map(([lemma, count]) => ({ lemma, count }));
      const strongsHotspots = [...strongsCount.entries()]
        .sort((a, c) => c[1] - a[1]).slice(0, 6)
        .map(([st, count]) => ({ st, count }));
      const keyStrongs = [...contentStrongsCount.entries()]
        .sort((a, c) => c[1] - a[1]).slice(0, 5)
        .map(([st, count]) => ({ st, count }));

      paths.push({
        params: { book: b.osis, chapter: ch },
        props: {
          osis: b.osis, bookZh: b.zh, bookEn: b.english,
          chapter: Number(ch),
          verses, tokenCount,
          verseCount: verses.length,
          topLemmas, strongsHotspots, keyStrongs,
          chapterNums: allChapters,
        },
      });
    }
  }
  return paths;
}

const { osis, bookZh, bookEn, chapter, verses, tokenCount, verseCount, topLemmas, strongsHotspots, keyStrongs, chapterNums } = Astro.props;

// 本章關鍵原文字 prose（GEO）：內容詞 Strong's × lexicon 字義接成自然語言敘述，
// 給 answer engine 可索引、可引用的內容（純本站分析 + 開放授權字義，無恢復本版權內容）。
const lexById: Record<string, { transliteration: string; short_definition: string; clean_gloss?: string; lemma: string }> =
  Object.fromEntries((lexiconData as any[]).map((e) => [e.strongs, e]));
const keyWords = (keyStrongs as any[])
  .map((s) => ({ ...s, lex: lexById[s.st] }))
  .filter((s) => s.lex && s.lex.short_definition);

// 章次內鏈：prev/next + 同書全章清單（使逐章頁互連、爬蟲可爬完整本書）
const chIdx = chapterNums.indexOf(chapter);
const prevCh = chIdx > 0 ? chapterNums[chIdx - 1] : null;
const nextCh = chIdx >= 0 && chIdx < chapterNums.length - 1 ? chapterNums[chIdx + 1] : null;

// 本章概要（chapter-summaries 全覆蓋；仍留空字串防呆，缺檔時區塊不渲染）
const summaryMod = summaryFiles[`../../../data/chapter-summaries/${osis}.json`];
const outline = summaryMod?.default?.[String(chapter)] ?? '';

// 選填默想/禱讀引導
const meditationMod = meditationFiles[`../../../data/chapter-meditations/${osis}.json`];
const meditation = meditationMod?.default?.[String(chapter)] ?? '';

// LSM API 可解析的整章引用（書名解析的雷與規則見 lib/lsmApi.ts buildLsmChapterRef）。
const lsmChapterRef = buildLsmChapterRef(osis, bookEn, chapter, chapterNums.length);

const isHebrew = !NT_OSIS.has(osis);
const langTag = isHebrew ? 'he' : 'grc';
const langDir = isHebrew ? 'rtl' : 'ltr';

const pageTitle = `${bookZh}第${chapter}章 查經｜原文逐字解析、Strong's 與恢復本`;
// meta keywords 用內容詞（名詞/動詞/形容詞），避免落入 the/and/of 等虛詞；無內容詞才退回 topLemmas。
const keywords = (keyWords.length ? keyWords.map((s: any) => s.lex.lemma) : topLemmas.map((l: any) => l.lemma))
  .slice(0, 4).join('、');
const pageDesc = `${bookZh}（${bookEn}）第${chapter}章希伯來/希臘文逐字對照，含 Strong's、詞形分析與恢復本經文。本章關鍵原文字：${keywords}。`;

const siteUrl = Astro.site?.origin ?? 'https://bible.weiqi.kids';
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const orgId = `${siteUrl}${base}/#organization`;
// datePublished：repo 首個 commit 日（內容上線日，誠實固定值）。
// dateModified：該卷資料實際最後變更日（git commit 日，data/lastmod.json 供表），
// 不用 build 日——每次部署都標「今天」等於對搜尋引擎謊報更新。
const datePublished = '2026-04-22';
const dateModified = (lastmod as { books: Record<string, string> }).books[osis] ?? datePublished;

// 逐章 FAQ（FAQPage）：從既有概要與關鍵字衍生，給 answer engine 直接可答的問答（GEO）。
const faqQ1 = `${bookZh}第${chapter}章在講什麼？`;
const faqQ2 = `${bookZh}第${chapter}章有哪些關鍵原文字？`;
const keyWordsAnswer = keyWords.length
  ? `本章較常出現的關鍵${isHebrew ? '希伯來' : '希臘'}文字包括：${keyWords.map((s: any) => `${s.lex.lemma}（${s.lex.clean_gloss || s.lex.short_definition}，${s.count} 次）`).join('、')}。`
  : '';
const faqItems: { q: string; a: string }[] = [];
if (outline) faqItems.push({ q: faqQ1, a: outline });
if (keyWordsAnswer) faqItems.push({ q: faqQ2, a: keyWordsAnswer });

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: `${siteUrl}${base}/` },
        { '@type': 'ListItem', position: 2, name: '書卷', item: `${siteUrl}${base}/books` },
        { '@type': 'ListItem', position: 3, name: bookZh, item: `${siteUrl}${base}/study/${osis}` },
        { '@type': 'ListItem', position: 4, name: `第${chapter}章` },
      ],
    },
    ...(faqItems.length ? [{
      '@type': 'FAQPage',
      mainEntity: faqItems.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }] : []),
    {
      '@type': 'Article',
      headline: pageTitle,
      description: pageDesc,
      inLanguage: 'zh-Hant',
      keywords,
      isPartOf: { '@type': 'Book', name: `${bookZh}（${bookEn}）` },
      url: pageUrl,
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      // Speakable：標記本章自然語言內容（導言 + 概要）供語音／answer engine 朗讀摘要。
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lede', '.outline', '.keywords'] },
      image: `${siteUrl}${base}/og/${osis}.png`,
      datePublished,
      dateModified,
      author: { '@id': orgId },
      publisher: { '@id': orgId },
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDesc} ogType="article" ogImage={`/og/${osis}.png`}>
  <article class="chapter">
    <nav class="crumb" aria-label="breadcrumb">
      <a href={`${base}/`}>首頁</a> ›
      <a href={`${base}/books`}>書卷</a> ›
      <span>{bookZh} 第{chapter}章</span>
    </nav>

    <h1>{bookZh} 第{chapter}章 <span class="en">{bookEn} {chapter}</span></h1>
    <p class="lede">原文逐字對照 · 恢復本經文對照 · 共 {verseCount} 節 / {tokenCount} 個原文 token</p>

    <nav class="chapter-nav" aria-label="本書章次">
      {prevCh ? <a class="cn-arrow" href={`${base}/study/${osis}/${prevCh}`} rel="prev">← 第{prevCh}章</a> : <span class="cn-arrow disabled">←</span>}
      <details class="cn-list">
        <summary>{bookZh} 全 {chapterNums.length} 章</summary>
        <div class="cn-grid">
          {chapterNums.map((n: number) => (
            n === chapter
              ? <span class="cn cur" aria-current="page">{n}</span>
              : <a class="cn" href={`${base}/study/${osis}/${n}`}>{n}</a>
          ))}
        </div>
      </details>
      {nextCh ? <a class="cn-arrow" href={`${base}/study/${osis}/${nextCh}`} rel="next">第{nextCh}章 →</a> : <span class="cn-arrow disabled">→</span>}
    </nav>

    {outline && (
      <section class="outline">
        <h2>{faqQ1}</h2>
        <p>{outline}</p>
      </section>
    )}

    {keyWords.length > 0 && (
      <section class="keywords">
        <h2>{faqQ2}</h2>
        <p>
          本章共 {verseCount} 節、{tokenCount} 個原文字。出現頻率較高的關鍵{isHebrew ? '希伯來' : '希臘'}文字（名詞、動詞、形容詞）包括：
          {keyWords.map((s, i) => (
            <Fragment>
              {i > 0 ? '、' : ''}
              <a href={`${base}/lexicon/${s.st}`}><span lang={langTag} dir={langDir}>{s.lex.lemma}</span>{s.lex.transliteration ? `（${s.lex.transliteration}）` : ''}</a>{s.lex.clean_gloss ? `，意為「${s.lex.clean_gloss}」` : ''}（{s.count} 次）
            </Fragment>
          ))}
          。點選任一字可查看其字義、詞形分析與在全本聖經的出現分布。
        </p>
      </section>
    )}

    {meditation && (
      <section class="meditation">
        <h2>默想 · 禱讀</h2>
        <p>{meditation}</p>
      </section>
    )}

    <details class="map">
      <summary>本章原文導覽（研究工具）</summary>
      <div class="map-body">
        {topLemmas.length > 0 && (
          <div>
            <strong>本章高頻原文字：</strong>
            {topLemmas.map((l: any) => (
              <span class="chip" lang={langTag} dir={langDir}>{l.lemma}<sup>{l.count}</sup></span>
            ))}
          </div>
        )}
        {strongsHotspots.length > 0 && (
          <div>
            <strong>Strong's 熱點：</strong>
            {strongsHotspots.map((s: any) => (
              <a class="chip" href={`${base}/lexicon/${s.st}`}>{s.st}<sup>{s.count}</sup></a>
            ))}
          </div>
        )}
        <div>
          <strong>逐節入口：</strong>
          {verses.map((v: any) => (
            <a class="vlink" href={`#v${v.num}`}>{chapter}:{v.num}</a>
          ))}
        </div>
      </div>
    </details>

    <div class="reading-bar">
      <ChapterRecovery client:visible chapterRef={lsmChapterRef} slotPrefix={`rec-${osis}-${chapter}-`} osis={osis} chapter={chapter} />
      {/* client:idle 而非 visible：本元件初始 SSR 為 null（supported 未定），
          client:visible 的 IntersectionObserver 無子元素可觀察會永不水合。 */}
      <ChapterReadAloud client:idle slotPrefix={`rec-${osis}-${chapter}-`} />
      <ChapterMusic client:idle osis={osis} />
    </div>

    <section class="verses">
      {verses.map((v: any) => (
        <article class="verse" id={`v${v.num}`}>
          <h3>{bookZh} {chapter}:{v.num}</h3>
          {/* 經文置頂：恢復本（中英）為主，runtime 填入；原文逐字對照收進折疊（研究時再展開） */}
          <div class="recovery-slot" id={`rec-${osis}-${chapter}-${v.num}`}></div>
          {v.tokens.length === 0 ? (
            <p class="no-orig">（此節恢復本所有；原文古卷多無，故無逐字對照）</p>
          ) : (
          <details class="il-detail">
            <summary>原文逐字對照</summary>
            <div class="il-scroll">
              <table class="il">
                <tbody>
                  <tr class="r-orig">
                    <th>原文</th>
                    {v.tokens.map((t: any) => (
                      <td lang={t.st?.startsWith('H') ? 'he' : 'grc'} dir={t.st?.startsWith('H') ? 'rtl' : 'ltr'}>{t.s}</td>
                    ))}
                  </tr>
                  <tr class="r-lemma">
                    <th>原型</th>
                    {v.tokens.map((t: any) => (
                      <td lang={langTag} dir={langDir}>{t.l}</td>
                    ))}
                  </tr>
                  <tr class="r-code">
                    <th>分析碼</th>
                    {v.tokens.map((t: any) => (<td class="mono">{t.ac}</td>))}
                  </tr>
                </tbody>
              </table>
            </div>
          </details>
          )}
        </article>
      ))}
    </section>

    <p class="attr">恢復本經文版權屬 LSM（Living Stream Ministry）所有，由 LSM Recovery Version API runtime 提供；原文資料來源 SBLGNT/MorphGNT、OSHB/WLC（公共領域）。</p>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .chapter { max-width: 900px; margin: 1.5rem auto; }
  .crumb { font-size: var(--font-sm); color: var(--color-text-secondary); margin-bottom: 0.5rem; }
  .crumb a { color: var(--color-primary); }
  h1 { font-size: var(--font-2xl); }
  h1 .en { font-size: var(--font-base); color: var(--color-text-muted); font-weight: 400; }
  .lede { color: var(--color-text-secondary); margin: 0.3rem 0 0.8rem; }
  .chapter-nav { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.2rem; font-size: var(--font-sm); }
  .cn-arrow { color: var(--color-primary); white-space: nowrap; }
  .cn-arrow.disabled { color: var(--color-text-muted); }
  .cn-list { flex: 1; min-width: 200px; }
  .cn-list summary { cursor: pointer; color: var(--color-text-secondary); }
  .cn-grid { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.5rem; }
  .cn { display: inline-block; min-width: 1.8rem; text-align: center; padding: 0.1rem 0.3rem; border: 1px solid var(--color-border, #ddd); border-radius: 4px; color: var(--color-primary); }
  .cn.cur { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
  .outline { background: var(--color-surface, #f6f1e7); border-left: 4px solid var(--color-primary); padding: 0.8rem 1rem; border-radius: 4px; margin-bottom: 1.2rem; }
  .outline h2 { font-size: var(--font-base); color: var(--color-primary); margin-bottom: 0.4rem; }
  .keywords { margin-bottom: 1.2rem; padding: 0.4rem 0; }
  .keywords h2 { font-size: var(--font-base); color: var(--color-primary); margin-bottom: 0.4rem; }
  .keywords p { line-height: 2; }
  .meditation { background: var(--color-surface-hover, #efe8da); border-left: 4px solid var(--color-recovery, #8a6d3b); padding: 0.8rem 1rem; border-radius: 4px; margin-bottom: 1.2rem; }
  .meditation h2 { font-size: var(--font-base); color: var(--color-recovery, #8a6d3b); margin-bottom: 0.4rem; }
  .meditation p { line-height: 1.9; }
  .reading-bar { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .map { border: 1px solid var(--color-border, #ddd); border-radius: 6px; padding: 0.5rem 0.8rem; margin-bottom: 1.5rem; }
  .map summary { cursor: pointer; font-weight: 700; color: var(--color-primary); }
  .map-body { margin-top: 0.7rem; display: grid; gap: 0.6rem; font-size: var(--font-sm); }
  .chip { display: inline-block; margin: 0.15rem 0.3rem 0.15rem 0; padding: 0.1rem 0.5rem; background: var(--color-surface, #efe8da); border-radius: 12px; }
  .chip sup { color: var(--color-text-muted); margin-left: 2px; }
  .vlink { display: inline-block; margin: 0.1rem 0.4rem 0.1rem 0; color: var(--color-primary); }
  .verse { padding: 0.8rem 0; border-bottom: 1px solid var(--color-border, #eee); scroll-margin-top: 1rem; }
  .verse h3 { font-size: var(--font-base); color: var(--color-primary); margin-bottom: 0.4rem; }
  .il-detail { margin-top: 0.5rem; }
  .il-detail summary { cursor: pointer; font-size: var(--font-sm); color: var(--color-text-secondary); }
  .il-scroll { overflow-x: auto; margin-top: 0.4rem; }
  .il { border-collapse: collapse; }
  .il th { text-align: right; padding-right: 0.6rem; color: var(--color-text-secondary); font-size: var(--font-sm); white-space: nowrap; }
  .il td { padding: 0.15rem 0.5rem; text-align: center; border-bottom: 1px dotted var(--color-border, #eee); }
  .il .r-orig td { font-size: var(--font-lg); }
  .mono { font-family: monospace; font-size: var(--font-sm); }
  .recovery-slot:not(:empty) { padding: 0.6rem 0.8rem; background: var(--color-surface, #f3eee2); border-radius: 4px; font-size: var(--font-lg); line-height: 1.85; }
  .no-orig { font-size: var(--font-sm); color: var(--color-text-muted); margin-top: 0.4rem; }
  .recovery-slot strong { color: var(--color-recovery, #8a6d3b); font-size: var(--font-sm); }
  .attr { font-size: var(--font-xs, 0.75rem); color: var(--color-text-muted); margin-top: 1.5rem; }
</style>
