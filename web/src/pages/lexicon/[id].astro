---
import BaseLayout from '../../layouts/BaseLayout.astro';
import lexiconData from '../../data/lexicon.json';
import occurrences from '../../data/strongs-occurrences.json';
import bookMap from '../../data/bookMap.json';
type LexiconEntry = { strongs: string; normalized_strongs: string; lemma: string; language: string; transliteration: string; pronunciation_bopomofo: string; short_definition: string; literal_gloss_en: string; clean_gloss?: string; common_inflections: string[]; analytical_notes: string[]; };
const entries = lexiconData as LexiconEntry[];
const occ = occurrences as Record<string, { n: number; ch: string[]; bk: Record<string, number> }>;
const osisZh: Record<string, string> = Object.fromEntries((bookMap as { osis: string; zh: string }[]).map(b => [b.osis, b.zh]));
export function getStaticPaths() {
  return (lexiconData as LexiconEntry[]).map(e => ({ params: { id: e.strongs } }));
}
const { id } = Astro.params;
const entry = entries.find(e => e.strongs === id)!;
const langTag = entry.language === 'Hebrew' ? 'he' : 'grc';
const langDir = entry.language === 'Hebrew' ? 'rtl' : 'ltr';

// 出現章節（entity graph / crawl 互鏈）：列出本字出現的章節，連回逐章研經頁。
// 常見字可達數百章 → 顯示上限 60，避免單頁連結過多稀釋權重；仍標示總數。
const MAX_CH = 60;
const occRec = occ[entry.strongs];
const occChapters = occRec?.ch ?? [];
const shownChapters = occChapters.slice(0, MAX_CH);
// 各書卷出現分布（靜態繪，取代原本讀空資料、永遠空白的 D3 client 島）
const bookDist = Object.entries(occRec?.bk ?? {});
const maxBook = bookDist.reduce((m, [, n]) => Math.max(m, n), 0);
const cleanGloss = entry.clean_gloss || entry.short_definition;

const siteUrl = Astro.site?.origin ?? 'https://bible.weiqi.kids';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const lexLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: `${siteUrl}${base}/` },
        { '@type': 'ListItem', position: 2, name: '原文字典', item: `${siteUrl}${base}/lexicon` },
        { '@type': 'ListItem', position: 3, name: `${entry.transliteration}（${entry.strongs}）` },
      ],
    },
    {
      '@type': 'DefinedTerm',
      '@id': pageUrl,
      name: entry.transliteration,
      description: cleanGloss,
      inDefinedTermSet: { '@type': 'DefinedTermSet', name: "Strong's Concordance" },
      identifier: entry.strongs,
      inLanguage: langTag,
    },
  ],
};
---
<BaseLayout title={`${entry.transliteration} ${entry.lemma}（${entry.strongs}）`} description={`${entry.transliteration} ${entry.lemma}（Strong's ${entry.strongs}）原文字義：${cleanGloss}`}>
  <nav class="crumb" aria-label="breadcrumb" style="margin: 1.5rem 0 0; font-size: var(--font-sm); color: var(--color-text-muted);">
    <a href={`${base}/`}>首頁</a> › <a href={`${base}/lexicon`}>原文字典</a> › <span>{entry.transliteration}（{entry.strongs}）</span>
  </nav>
  <article style="margin: 1rem 0 2rem;">
    <h1>
      <span lang={langTag} dir={langDir}>{entry.lemma}</span>
      <span class="mono" style="font-size: var(--font-lg); color: var(--color-text-muted); margin-left: 0.5rem;">{entry.strongs}</span>
    </h1>
    <div class="detail-grid">
      <div class="card">
        <h3>基本資訊</h3>
        <dl>
          <dt>語言</dt><dd>{entry.language}</dd>
          <dt>音譯</dt><dd>{entry.transliteration}</dd>
          <dt>注音</dt><dd>{entry.pronunciation_bopomofo}</dd>
          <dt>簡義</dt><dd>{cleanGloss}</dd>
          <dt>Strong's 原義</dt><dd class="raw-gloss">{entry.short_definition}</dd>
        </dl>
      </div>
      <div class="card">
        <h3>常見變形</h3>
        <ul>{entry.common_inflections.map(inf => <li class="mono">{inf}</li>)}</ul>
      </div>
      <div class="card">
        <h3>分析注記</h3>
        <ul>{entry.analytical_notes.map(note => <li>{note}</li>)}</ul>
      </div>
    </div>
  </article>

  {occChapters.length > 0 && (
    <section class="occ" aria-label="出現章節">
      <h2>出現於（{occRec!.n} 次 · {occChapters.length} 章）</h2>
      <p class="occ-hint">點選章節查看 <span lang={langTag} dir={langDir}>{entry.lemma}</span> 在該章的原文逐字對照與恢復本經文。</p>
      <ul class="occ-list">
        {shownChapters.map((c) => {
          const [osis, ch] = c.split('.');  // "Gen.1" → ["Gen","1"]；OSIS 書碼無點，可安全分割
          return (
            <li><a href={`${base}/study/${osis}/${ch}`}>{osisZh[osis] ?? osis} {ch}</a></li>
          );
        })}
      </ul>
      {occChapters.length > MAX_CH && (
        <p class="occ-more">…共 {occChapters.length} 章，顯示前 {MAX_CH} 章。</p>
      )}
    </section>
  )}

  {bookDist.length > 0 && (
    <section class="dist" aria-label="各書卷出現分布">
      <h2>各書卷出現分布</h2>
      <ul class="dist-list">
        {bookDist.map(([osis, n]) => (
          <li class="dist-row">
            <a class="dist-book" href={`${base}/study/${osis}/1`}>{osisZh[osis] ?? osis}</a>
            <span class="dist-bar-wrap"><span class="dist-bar" style={`width:${Math.max(2, (n / maxBook) * 100)}%`}></span></span>
            <span class="dist-n mono">{n}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
  <script type="application/ld+json" set:html={JSON.stringify(lexLd)} />
</BaseLayout>
<style>
  h1 { margin-bottom: 1.5rem; }
  .detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
  .detail-grid h3 { font-size: var(--font-base); margin-bottom: 0.8rem; color: var(--color-primary); }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1rem; font-size: var(--font-sm); }
  dt { font-weight: 700; color: var(--color-text-secondary); }
  ul { padding-left: 1.2rem; font-size: var(--font-sm); }
  li { margin-bottom: 0.3rem; }
  .occ { margin: 2.5rem 0; }
  .occ h2 { font-size: var(--font-lg); margin-bottom: 0.4rem; }
  .occ-hint { font-size: var(--font-sm); color: var(--color-text-secondary); margin-bottom: 1rem; }
  .occ-list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 0.6rem; }
  .occ-list li { margin: 0; }
  .occ-list a { display: inline-block; padding: 0.2rem 0.6rem; border: 1px solid var(--color-border); border-radius: 999px; font-size: var(--font-sm); white-space: nowrap; }
  .occ-list a:hover { background: var(--color-surface-hover); }
  .occ-more { font-size: var(--font-sm); color: var(--color-text-muted); margin-top: 0.8rem; }
  .raw-gloss { color: var(--color-text-muted); font-size: var(--font-xs); }
  .dist { margin: 2.5rem 0; max-width: 640px; }
  .dist h2 { font-size: var(--font-lg); margin-bottom: 1rem; }
  .dist-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .dist-row { display: grid; grid-template-columns: 5.5rem 1fr 2.5rem; align-items: center; gap: 0.6rem; font-size: var(--font-sm); }
  .dist-book { text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dist-bar-wrap { background: var(--color-surface); border-radius: 4px; overflow: hidden; height: 1.1rem; }
  .dist-bar { display: block; height: 100%; background: var(--color-primary); border-radius: 4px; }
  .dist-n { text-align: right; color: var(--color-text-secondary); }
</style>
