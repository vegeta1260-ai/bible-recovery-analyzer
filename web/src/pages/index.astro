---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/islands/SearchBox.tsx';
import BookGrid from '../components/static/BookGrid.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="首頁" description="聖經恢復本原文字義解析 — 搜尋經文、逐字對照、原文研究">
  {/* hero 為 LCP 元素：直接渲染、首屏即可見，不再以 client:idle 的 JS 動畫 gating
      （ScrollUnfold 會用 opacity:0 + clip-path 先藏住，拖累 LCP 並對無 JS/爬蟲不友善）。 */}
  <section class="hero">
    <h1>聖經恢復本原文字義解析</h1>
    <p class="hero-sub">搜尋經文查看恢復本 + 原文逐字對照 + 研究卡</p>
  </section>

  <SearchBox client:load />

  <section class="book-section">
    <h2>書卷快速入口</h2>
    <BookGrid />
  </section>

  <section class="intro">
    <h2>這個網站能做什麼</h2>
    <p>
      本站把聖經<strong>恢復本</strong>的中文經文，與希伯來文、希臘文<strong>原文逐字</strong>對照在一起。
      新舊約全 66 卷、共 1,189 章，每一章都有獨立的研經頁，呈現原文逐字解析、本章概要，以及恢復本經文對照。
    </p>
    <p>
      每個原文字都附上 <strong>Strong's 編號</strong>、字典原形（lemma）與<strong>詞形分析碼</strong>，
      可在<a href={`${base}/lexicon`}>原文字典</a>中追蹤同一個字在全本聖經的出現與字義。
      想了解恢復本、原文資料來源或代碼讀法，請看<a href={`${base}/faq`}>常見問題</a>。
    </p>
    <p class="src-note">
      原文資料採用 OSHB／WLC（希伯來文）與 SBLGNT／MorphGNT（希臘文）等開放授權底本；
      恢復本經文由水流職事站（LSM）官方 API 即時提供。
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0 1rem;
  }
  .hero h1 {
    font-size: var(--font-2xl);
  }
  .hero-sub {
    color: var(--color-text-secondary);
    font-size: var(--font-lg);
    margin-top: 0.5rem;
  }
  .book-section {
    margin-top: 3rem;
  }
  .book-section h2 {
    font-size: var(--font-xl);
    margin-bottom: 1rem;
  }
  .intro {
    margin-top: 3rem;
    max-width: 760px;
  }
  .intro h2 {
    font-size: var(--font-xl);
    margin-bottom: 1rem;
  }
  .intro p {
    line-height: 1.9;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
  .intro .src-note {
    font-size: var(--font-sm);
    color: var(--color-text-muted);
  }
</style>
