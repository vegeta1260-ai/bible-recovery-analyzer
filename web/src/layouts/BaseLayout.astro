---
import Header from '../components/static/Header.astro';
import Footer from '../components/static/Footer.astro';
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonicalUrl?: string;
  ogType?: string;
  noindex?: boolean;
}
const {
  title,
  description = '聖經恢復本原文字義解析工具 — 希伯來文、希臘文 Strong\'s 編號、詞形分析、全文搜尋',
  ogImage = '/og-default.png',
  ogImageAlt,
  canonicalUrl,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const fullTitle = `${title} | 聖經原文解析`;
const siteUrl = Astro.site?.origin ?? 'https://bible.weiqi.kids';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
// og/twitter 圖需含 base path（base='/' 時為空字串；換回子路徑部署時才有前綴）。
// ogImage 為 root-relative（如 /og-default.png），缺 base 會 404 → 分享卡無圖。
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${base}${ogImage}`;

// 全站結構化資料：Organization（來源歸因，供 answer engine 引用時識別發行者）
// + WebSite（含 SearchAction，對應首頁 /?ref= 經文查詢端點，可拿 sitelinks searchbox）。
// 用穩定 @id 讓各頁 Article 的 publisher 可 $ref 這裡，不重複定義實體。
const orgId = `${siteUrl}${base}/#organization`;
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: '聖經原文解析',
      url: `${siteUrl}${base}/`,
      logo: `${siteUrl}${base}/og-default.png`,
      description: '提供聖經希伯來文、希臘文原文逐字解析、Strong\'s 編號與詞形分析的免費研經工具，並對照恢復本經文。',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}${base}/#website`,
      name: '聖經原文解析',
      url: `${siteUrl}${base}/`,
      inLanguage: 'zh-Hant',
      publisher: { '@id': orgId },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteUrl}${base}/?ref={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
// Cloudflare Web Analytics（免費、無 cookie）。只有設定 PUBLIC_CF_BEACON_TOKEN 才注入 beacon；
// 未設定則不渲染，build 不受影響。token 由 CF 儀表板取得，於 GitHub repo variable 設定。
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? fullTitle} />
    <meta property="og:site_name" content="聖經原文解析" />
    <meta property="og:locale" content="zh_TW" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? fullTitle} />

    <!-- 全站結構化資料（Organization + WebSite/SearchAction） -->
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />

    <!-- 字型 self-host（去 Google 依賴）：woff2 與 fonts.css 同置 /fonts/，CSS 內用相對 url
         （與 base path 無關）。保留 unicode-range 分塊，瀏覽器只抓實際用到的字（含 runtime 恢復本經文）。
         以正常 stylesheet 載入（同源、僅 @font-face、gzip 後小）：讓 font-display:optional 有套用窗口，
         字型未及時則用系統 fallback 且「不再 swap」→ 消除字型重排造成的 CLS。 -->
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />

    <!-- 主題/字級初始化必須在 <head> 同步執行（首屏繪製前設好 data-theme），
         放 </body> 前的話大章頁深色模式會先閃白。 -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme) document.documentElement.setAttribute('data-theme', theme);
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.setAttribute('data-theme', 'dark');
        var scale = localStorage.getItem('fontScale');
        if (scale) document.documentElement.setAttribute('data-font-scale', scale);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">跳至主要內容</a>
    <Header />
    {/* tabindex=-1 讓 skip link 觸發後鍵盤焦點真正落在主內容（純錨點只捲動不移焦） */}
    <main id="main" class="container" tabindex="-1"><slot /></main>
    <Footer />
    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
      />
    )}
  </body>
</html>
