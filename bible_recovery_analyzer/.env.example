# Default local mode (no real credential required)
RECOVERY_PROVIDER=mock

# LSM API (formal integration)
RECOVERY_API_BASE_URL=https://api.lsm.example/recovery-text
RECOVERY_API_TOKEN=
# legacy alias still supported by code: RECOVERY_API_KEY
RECOVERY_API_TIMEOUT=12
RECOVERY_API_LANG=
RECOVERY_API_OUTPUT=json
RECOVERY_API_REF_PARAM=String
RECOVERY_API_OUTPUT_PARAM=Out
RECOVERY_API_LANG_PARAM=Lang

# auth mode: header | query | none
RECOVERY_API_AUTH_MODE=header
RECOVERY_API_AUTH_HEADER=Authorization
RECOVERY_API_AUTH_HEADER_PREFIX=Bearer 
RECOVERY_API_AUTH_QUERY_PARAM=token

RECOVERY_RETRY_ATTEMPTS=2
SIMULATE_LSM_REJECTION=false
RECOVERY_ENABLE_WEB_FALLBACK_FROM_LSM=true

# Web fallback (test-only)
RECOVERY_WEB_BASE_URL=
RECOVERY_WEB_FETCH_ENABLED=false
RECOVERY_WEB_USER_AGENT=BibleRecoveryAnalyzer/0.3
RECOVERY_WEB_TIMEOUT_SECONDS=10
RECOVERY_WEB_ROUTE_TEMPLATE=verse/{ref}
RECOVERY_WEB_SELECTOR=
RECOVERY_WEB_EXTRACT_MARKER_START=
RECOVERY_WEB_EXTRACT_MARKER_END=
RECOVERY_WEB_MAX_CHARS=600

# Local sqlite
SQLITE_PATH=./data/bible_analyzer.db
